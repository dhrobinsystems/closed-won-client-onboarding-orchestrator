# =============================================================================
# closed-won-client-onboarding-orchestrator - environment configuration
# -----------------------------------------------------------------------------
# Copy to your n8n host's environment (docker-compose `environment:`, a systemd
# EnvironmentFile, or your platform's secret manager). NEVER commit a real .env.
#
# API tokens for HubSpot, Slack, Google Drive, the project workspace and the
# LLM do NOT go here. They live in n8n Credentials (see docs/SETUP.md).
#
# n8n requirements for these workflows:
#   N8N_BLOCK_ENV_ACCESS_IN_NODE=false   # lets Code nodes read the variables below
#   NODE_FUNCTION_ALLOW_BUILTIN=crypto   # Slack/HubSpot signature verification
# =============================================================================

# --- Safety -------------------------------------------------------------------
# true (default) = dry run: reads HubSpot, posts a preview to the approval
# channel, and creates/invites/writes NOTHING. Only the exact values
# false/0/no/off switch to live mode. Anything unrecognised stays in sandbox.
SANDBOX_MODE=true

# --- HubSpot ------------------------------------------------------------------
# Internal ID of the "Closed Won" stage (Settings > Objects > Deals > Pipelines).
# The default pipeline uses "closedwon"; custom pipelines use numeric IDs.
HUBSPOT_CLOSED_WON_STAGE_ID=closedwon
# Optional: only process deals in this pipeline ID. Leave empty for all pipelines.
HUBSPOT_PIPELINE_ID=
# Optional: your portal (hub) ID, used to build deal links in Slack messages.
HUBSPOT_PORTAL_ID=
# Internal name of the deal property holding sales intake / discovery notes.
HUBSPOT_INTAKE_NOTES_PROPERTY=deal_intake_notes
# Optional but recommended for HubSpot app webhooks: the app's client secret,
# used to verify X-HubSpot-Signature-v3 on inbound events.
HUBSPOT_APP_CLIENT_SECRET=
# Required when HUBSPOT_APP_CLIENT_SECRET is set: the exact public URL HubSpot
# calls (the n8n production webhook URL of workflow 01).
HUBSPOT_WEBHOOK_TARGET_URL=

# --- Slack --------------------------------------------------------------------
# Internal hand-off channel for approval gates and sandbox previews.
# Use a channel ID (C0123ABCD) or #name; the bot must be a member.
SLACK_INTERNAL_APPROVAL_CHANNEL=#cs-handoffs
# Prefix for client channels: <prefix>-<company-slug>-onboarding
SLACK_CHANNEL_PREFIX=client
# Create client channels as private (recommended).
SLACK_PRIVATE_CHANNELS=true
# Comma-separated Slack user IDs added to every new client channel.
# Required in live mode (otherwise only the bot is in the channel).
SLACK_INTERNAL_MEMBER_IDS=
# Comma-separated Slack user IDs allowed to press Approve / Hold.
# Required in live mode. In sandbox, empty means anyone may click (previews only).
APPROVER_SLACK_USER_IDS=
# Slack app signing secret (Basic Information > App Credentials).
# Required by workflow 02; signatures are verified in every mode.
SLACK_SIGNING_SECRET=
# Maximum age of a Slack request in seconds (replay protection). 30-900.
SLACK_SIGNATURE_TOLERANCE_SECONDS=300

# --- Google Drive -------------------------------------------------------------
# Parent folder ID (from the folder URL) under which client folders are created.
# Shared drives are supported. Required in live mode.
DRIVE_PARENT_FOLDER_ID=

# --- Project workspace ----------------------------------------------------------
# One of: clickup | asana | notion
WORKSPACE_PROVIDER=clickup
# ClickUp: Space ID | Asana: Team GID | Notion: parent page ID.
# Required in live mode.
WORKSPACE_CONTAINER_ID=

# --- LLM kickoff agenda -------------------------------------------------------
# One of: none | openai | anthropic. "none" uses a deterministic template.
LLM_PROVIDER=none
# Model name for the selected provider (required unless LLM_PROVIDER=none).
LLM_MODEL=
# Maximum output tokens for the agenda. 200-8000.
LLM_MAX_TOKENS=1200
# Optional sampling temperature 0-1. Leave empty for the provider default
# (some reasoning models reject a custom temperature).
LLM_TEMPERATURE=

# --- External invite guardrails -----------------------------------------------
# match_company_domain (default): only contacts whose email domain matches the
# HubSpot company domain (or a subdomain). allowlist: only the domains below.
EXTERNAL_INVITE_DOMAIN_POLICY=match_company_domain
# Comma-separated domains, used when EXTERNAL_INVITE_DOMAIN_POLICY=allowlist.
EXTERNAL_INVITE_ALLOWED_DOMAINS=
# Hard cap on external invites per deal. 1-50.
MAX_EXTERNAL_INVITES=10

# --- Misc ---------------------------------------------------------------------
# Your company name as shown to clients in the welcome packet.
ORG_DISPLAY_NAME=dhRobin Systems
# In-flight duplicate-delivery lock lifetime in minutes. 1-1440.
IDEMPOTENCY_LOCK_TTL_MINUTES=15
